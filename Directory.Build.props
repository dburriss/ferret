<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Version>0.3.0</Version>
    <PackageReleaseNotes>`FerretOptions.ModelUrl` and `FERRET_MODEL_URL` to download the model from a mirror (checksums still verified).
`FerretClient.IsModelAvailable`, a non-throwing check so a host can decide when to download the model.
`CancellationToken` overloads of `FerretClient.Search` and `BuildIndex`, `SearchAsync` and `BuildIndexAsync`, and `EnsureModelAsync(ct)`. A cancelled run throws `OperationCanceledException` and leaves the saved indexes untouched; the model download is now asynchronous I/O and cancellable.
Ctrl+C during `--index`, `--lex`, `--sem`, `--hybrid` or `--model download` now stops cleanly (exit 130).</PackageReleaseNotes>
    <!-- Flexi.Yaml needs at least this FSharp.Core; the SDK's implicit version is older. -->
    <FSharpCoreImplicitPackageVersion>10.1.403</FSharpCoreImplicitPackageVersion>
  </PropertyGroup>
  <PropertyGroup>
    <Authors>Devon Burriss</Authors>
    <Copyright>Copyright © 2026 Devon Burriss</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>search;bm25;semantic-search;hybrid-search;ripgrep;fsharp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/dburriss/ferret</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dburriss/ferret</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
</Project>