<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Version>0.1.0</Version>
    <PackageReleaseNotes>`ferret` command: ripgrep-compatible plain search with `.gitignore` support, line numbers, counts, fixed strings, word matching and stdin.
Ranked search with `--lex` (BM25, with boosts for path, heading and front-matter matches), plus `--limit`, `--scores`, `--jsonl` and `--timings`.
Semantic search with `--sem` and hybrid search with `--hybrid` (BM25 and semantic rankings fused). The model downloads on first use; `--model download` fetches it ahead of time.
A persisted index so repeated ranked searches only read new or changed files, with `--index` and `--clean` to build or remove it.
`Ferret` library: a `FerretClient` for setting up, indexing and searching in lexical, semantic or hybrid mode from .NET code.</PackageReleaseNotes>
    <!-- Flexi.Yaml needs at least this FSharp.Core; the SDK's implicit version is older. -->
    <FSharpCoreImplicitPackageVersion>10.1.403</FSharpCoreImplicitPackageVersion>
  </PropertyGroup>
  <PropertyGroup>
    <Authors>Devon Burriss</Authors>
    <Copyright>Copyright © 2026 Devon Burriss</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>search;bm25;semantic-search;hybrid-search;ripgrep;fsharp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/dburriss/ferret</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dburriss/ferret</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
</Project>