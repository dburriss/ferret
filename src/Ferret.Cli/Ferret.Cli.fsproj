<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.0</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ferret</ToolCommandName>
    <PackageId>Ferret.Cli</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Args.fs" />
    <Compile Include="Deps.fs" />
    <Compile Include="Output.fs" />
    <Compile Include="GrepCli.fs" />
    <Compile Include="RankedCli.fs" />
    <Compile Include="MaintenanceCli.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Argu" Version="6.2.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ferret\Ferret.fsproj" />
  </ItemGroup>

</Project>
