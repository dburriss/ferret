<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ferret</ToolCommandName>
    <PackageId>Ferret.Tool</PackageId>
    <Description>ferret: a ripgrep-compatible search command with ranked lexical (BM25), semantic and hybrid search.</Description>
    <!-- Single-file publish bundles Argu, ONNX Runtime and reflection-based code, so trimming is unsafe. -->
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>ferret</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Args.fs" />
    <Compile Include="Deps.fs" />
    <Compile Include="Output.fs" />
    <Compile Include="GrepCli.fs" />
    <Compile Include="RankedCli.fs" />
    <Compile Include="MaintenanceCli.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Argu" Version="6.2.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ferret\Ferret.fsproj" />
    <!-- Ferret references these privately (they are bundled into its package), so they do not flow here. -->
    <ProjectReference Include="..\Ferret.Core\Ferret.Core.fsproj" />
    <ProjectReference Include="..\Ferret.Semantic\Ferret.Semantic.fsproj" />
  </ItemGroup>

</Project>
