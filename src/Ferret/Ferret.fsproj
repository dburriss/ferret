<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Ferret</PackageId>
    <!-- Not "Ferret": the CLI assembly is "ferret", and the two names collide on case-insensitive file systems. -->
    <AssemblyName>Ferret.Client</AssemblyName>
    <Description>Lexical (BM25), semantic and hybrid file search for .NET: point it at some folders, build an index and search, without knowing how it works inside.</Description>
    <!-- Ferret.Core and Ferret.Semantic ship inside this package (see IncludeBundledProjects). -->
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeBundledProjects</TargetsForTfmSpecificBuildOutput>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Client.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ferret.Core\Ferret.Core.fsproj" PrivateAssets="all" />
    <ProjectReference Include="..\Ferret.Semantic\Ferret.Semantic.fsproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Private project references do not flow to consumers, so their package dependencies are declared here. -->
  <ItemGroup>
    <PackageReference Include="Flexi.Yaml" Version="0.1.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
  </ItemGroup>

  <Target Name="IncludeBundledProjects" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference'" />
    </ItemGroup>
  </Target>

</Project>
